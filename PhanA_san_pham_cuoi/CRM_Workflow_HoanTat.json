      "parameters": {
        "jsCode": "// Phân loại cảm xúc nhanh theo Baseline số sao (rating <= 2 là Negative, còn lại Positive)\nconst input = $('1. Webhook Trigger').first().json.body || $('1. Webhook Trigger').first().json;\nconst rating = parseInt(input.rating || 5);\nconst sentiment = rating <= 2 ? \"Negative\" : \"Positive\";\n\nreturn [{\n  json: {\n    ...input,\n    sentiment: sentiment\n  }\n}];"
      },
