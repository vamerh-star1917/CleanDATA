    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  try {\n    const rawText = item.json.content?.[0]?.text || item.json.text || \"{}\";\n    const cleanStr = rawText.replace(/```json/gi, '').replace(/```/gi, '').trim();\n    const parsed = JSON.parse(cleanStr);\n    \n    item.json.issue_type = parsed.issue_type || \"other\";\n    item.json.reason = parsed.reason || \"Không xác định được nguyên nhân cụ thể\";\n    item.json.response_draft = parsed.response_draft || \"Cảm ơn bạn đã phản hồi, shop sẽ kiểm tra lại.\";\n  } catch (err) {\n    item.json.issue_type = \"other\";\n    item.json.reason = \"Cần nhân viên kiểm tra lại phản hồi\";\n    item.json.response_draft = \"Dạ shop đã nhận được thông tin phản hồi và đang tiến hành xử lý cho quý khách.\";\n  }\n}\nreturn $input.all();"
      },
